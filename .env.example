# ═══════════════════════════════════════════
#  WA-AKG Business — Environment Config
# ═══════════════════════════════════════════
# Cara pakai:
#   cp .env.example .env  →  edit .env  →  docker compose up --build
#
# Arsitektur:
#   nginx (port 4040 ke host) → frontend:4041 + backend:4000 (internal network)

# ── 1. WAJIB DIUBAH (Keamanan & JWT) ────────────────
PORT=4040
APP_PORT=4000
# Generate 32+ bytes random string (contoh: openssl rand -hex 32)
APP_SECRET=ganti-dengan-string-acak-minimal-32-karakter-1
# REFRESH_SECRET HARUS BERBEDA dari APP_SECRET!
REFRESH_SECRET=ganti-dengan-string-acak-minimal-32-karakter-2
NODE_ENV=production
FRONTEND_URL=http://localhost:4040

# ── 2. AI CHATBOT (OpenAI / OpenRouter / Groq) ─────
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-your-openai-api-key-here
AI_MODEL=gpt-4o
AI_MAX_TOKENS=1024

# ── 3. WEBHOOKS & SECURITY ─────────────────────────
# Biarkan false di server produksi (mencegah SSRF ke IP privat / metadata AWS/GCP).
# Set true jika testing webhook ke localhost/LAN.
ALLOW_LOCAL_WEBHOOKS=false

# ── 4. WEB PUSH NOTIFIKASI BROWSER (VAPID) ─────────
# Generate key pair: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com
NEXT_PUBLIC_VAPID_KEY=

# ── 5. SEED INITIAL PASSWORDS (Opsional) ───────────
# Jika dikosongkan, password acak akan dibuat saat migrasi pertama kali.
SEED_SUPER_ADMIN_PASSWORD=admin123
SEED_ADMIN_PASSWORD=admin123
SEED_CS_PASSWORD=cs123

# ── 6. DATABASE & REDIS (Docker Default) ───────────
DB_PATH=file:./data/wa_akg.db
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_EXT_PORT=6380

# ── 7. PENGATURAN LAINNYA ──────────────────────────
WA_SESSION_PATH=./sessions
RATE_LIMIT_ENABLED=true
TIMEZONE=Asia/Jakarta
MESSAGES_PAGE_SIZE=30
CONVERSATIONS_PAGE_SIZE=20
MESSAGES_SOFT_CAP=5000
CONTEXT_EXPIRY_DAYS=90
NOTIF_QUEUE_THRESHOLD=5
NOTIF_DEBOUNCE_SECONDS=30


